{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlasmaStorm49/musicle-jp/shared/schema/artist-list.schema.json",
  "title": "Lista de artistas do musicle-jp",
  "description": "O índice do modo por artista (M13): os artistas na ordem da curadoria (artists.toml) e o arquivo de cada um. Gerado só pelo pipeline (build-artists).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "storefront", "artists"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "type": "string", "pattern": "^[a-z]+$" },
    "storefront": { "type": "string", "pattern": "^[a-z]{2}$" },
    "artists": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "optionalText": { "type": ["string", "null"], "minLength": 1 },
    "artistId": { "type": "string", "pattern": "^[a-z]+:ar:[A-Za-z0-9_-]+$" },
    "entry": {
      "title": "Artista da lista do musicle-jp",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "nameLatin", "file", "songs"],
      "properties": {
        "id": { "$ref": "#/$defs/artistId" },
        "name": { "$ref": "#/$defs/text" },
        "nameLatin": { "$ref": "#/$defs/optionalText" },
        "file": {
          "description": "Arquivo do artista, na mesma pasta do índice.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.json$"
        },
        "songs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
