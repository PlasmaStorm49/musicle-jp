{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlasmaStorm49/musicle-jp/shared/schema/anime-schedule.schema.json",
  "title": "Agenda do Anime do musicle-jp",
  "description": "Os 6 diários de cada dia do Anime (M14): 2 modos (acertar a música e acertar o anime) × 3 dificuldades, de 3 rodadas digitadas cada (P231, P232). Só cresce: um dia gravado nunca muda. Gerado só pelo pipeline (comando schedule-anime).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "timezone", "epoch", "days"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": {
      "description": "Distingue a agenda do Anime da dos Hits (o schedule-check despacha pelo tipo).",
      "const": "anime"
    },
    "timezone": { "const": "America/Sao_Paulo" },
    "epoch": { "$ref": "#/$defs/date" },
    "days": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/date" },
      "additionalProperties": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "trackId": { "type": "string", "pattern": "^[a-z]+:tr:[A-Za-z0-9_-]+$" },
    "round": {
      "title": "Rodada do Anime do musicle-jp",
      "description": "A faixa tocada. No acertar o anime, a resposta é a franquia dela (P234).",
      "type": "object",
      "additionalProperties": false,
      "required": ["answer"],
      "properties": {
        "answer": { "$ref": "#/$defs/trackId" }
      }
    },
    "rounds": {
      "title": "Rodadas de um diário do Anime do musicle-jp",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/round" }
    },
    "mode": {
      "title": "Diários de um modo do Anime do musicle-jp",
      "description": "Um diário por dificuldade (P232).",
      "type": "object",
      "additionalProperties": false,
      "required": ["facil", "medio", "dificil"],
      "properties": {
        "facil": { "$ref": "#/$defs/rounds" },
        "medio": { "$ref": "#/$defs/rounds" },
        "dificil": { "$ref": "#/$defs/rounds" }
      }
    },
    "day": {
      "title": "Dia da agenda do Anime do musicle-jp",
      "description": "Os diários do modo musica (acertar a música) e do modo titulo (acertar o anime).",
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "catalogVersion", "musica", "titulo"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "catalogVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[0-9a-f]{8}$" },
        "musica": { "$ref": "#/$defs/mode" },
        "titulo": { "$ref": "#/$defs/mode" }
      }
    }
  }
}
