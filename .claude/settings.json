{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(npm run *)",
      "PowerShell(npx vitest *)",
      "PowerShell(.venv\\Scripts\\python -m pytest *)",
      "PowerShell(.venv\\Scripts\\python -m ruff *)",
      "PowerShell(.venv\\Scripts\\python -m musicle_pipeline *)",
      "PowerShell(.venv/Scripts/python -m pytest *)",
      "PowerShell(.venv/Scripts/python -m ruff *)",
      "PowerShell(.venv/Scripts/python -m musicle_pipeline *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/Scripts/python -m ruff *)",
      "Bash(.venv/Scripts/python -m musicle_pipeline *)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(/web/public/data/**)",
      "Edit(/web/public/fixtures/*.json)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  }
}
