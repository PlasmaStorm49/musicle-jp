{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(npm run *)",
      "PowerShell(npx vitest *)",
      "PowerShell(.venv\\Scripts\\python -m pytest *)",
      "PowerShell(.venv\\Scripts\\python -m ruff *)",
      "PowerShell(.venv\\Scripts\\python -m musicle_pipeline *)",
      "PowerShell(.venv/Scripts/python -m pytest *)",
      "PowerShell(.venv/Scripts/python -m ruff *)",
      "PowerShell(.venv/Scripts/python -m musicle_pipeline *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/Scripts/python -m ruff *)",
      "Bash(.venv/Scripts/python -m musicle_pipeline *)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(/web/public/data/**)",
      "Edit(/web/public/fixtures/*.json)",
      "Edit(/pipeline/data/romaji.json)",
      "Edit(/shared/vectors/prng.json)",
      "Edit(/web/src/core/generated/**)",
      "Edit(/web/package-lock.json)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_file.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
