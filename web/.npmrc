# Versões exatas no package.json.
save-exact=true
# Nenhuma dependência, direta ou indireta, com menos de 14 dias de publicada: dá tempo de bugs
# graves e pacotes comprometidos aparecerem. Exceções só para patch de segurança com aviso
# publicado (decisões P28 e P29 em docs/PLANO.md).
min-release-age=14
min-release-age-exclude[]=vite
min-release-age-exclude[]=source-map-js
