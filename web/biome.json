{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!src/core/generated", "!dist", "!coverage", "!public"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "src/data/**", "src/storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "preact": "O núcleo é TypeScript puro: não importa Preact (regra inviolável 1).",
                  "preact/hooks": "O núcleo é TypeScript puro: não importa Preact (regra inviolável 1).",
                  "preact/compat": "O núcleo é TypeScript puro: não importa Preact (regra inviolável 1)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
